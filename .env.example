# Envío real de entradas y recibos por correo (opcional).
# 1) Copiá este archivo como .env
# 2) Generá una "contraseña de aplicación" en tu cuenta de Google (Seguridad > Verificación en 2 pasos > Contraseñas de aplicaciones)
# 3) Ejecutá "npm install" una vez (instala nodemailer)
# Sin este archivo, el sistema funciona igual y el envío queda simulado.

GMAIL_USER=tu.correo@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
PORT=3000
